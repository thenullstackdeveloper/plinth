{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plinth.dev/schema/plinth.template.schema.json",
  "title": "Plinth template",
  "description": "Declarative contract for a panel template. Source of truth for the shape; actions are validated against the domain's closed catalog.",
  "type": "object",
  "required": ["schema_version", "metadata", "pages", "sidebar"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Version of the schema the template was created with."
    },
    "metadata": {
      "type": "object",
      "required": ["game", "version", "author"],
      "additionalProperties": false,
      "properties": {
        "game": { "type": "string" },
        "version": { "type": "string" },
        "author": { "type": "string" }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/page" }
    },
    "sidebar": {
      "type": "object",
      "required": ["default_side", "components"],
      "additionalProperties": false,
      "properties": {
        "default_side": { "enum": ["left", "right"] },
        "components": {
          "type": "array",
          "items": { "$ref": "#/$defs/component" }
        }
      }
    },
    "theme": {
      "type": "object",
      "description": "Overrides of the design tokens, as a flat map from a token path ('color.button.background') to a scalar. Only the shape is checked here; the token catalog decides which tokens exist, which may change and which values they accept.",
      "maxProperties": 32,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){1,3}$" },
      "additionalProperties": {
        "oneOf": [
          { "type": "string", "pattern": "^[#A-Za-z0-9.-]{1,32}$" },
          { "type": "number" }
        ]
      }
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "required": ["components"],
      "additionalProperties": false,
      "properties": {
        "components": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component" }
        }
      }
    },
    "component": {
      "type": "object",
      "required": ["id", "position"],
      "oneOf": [{ "required": ["action"] }, { "required": ["keys"] }],
      "not": { "required": ["icon", "image"] },
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "position": {
          "type": "object",
          "required": ["row", "col"],
          "additionalProperties": false,
          "properties": {
            "row": { "type": "integer", "minimum": 0 },
            "col": { "type": "integer", "minimum": 0 }
          }
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "description": "Identifier resolvable by the catalog: 'app.*' for app actions, or a semantic game ID."
        },
        "keys": {
          "description": "Literal keys sent on a tap: one step ('m', 'shift+1') or a list of up to 16 steps fired in order. A step is 'mod+...+key' with shift, ctrl or alt as modifiers.",
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": { "type": "string", "minLength": 1 }
            }
          ]
        },
        "label": { "type": "string" },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 259,
          "description": "A small PNG or WebP next to the label, or alone with hide_label: a path relative to the template's folder, like 'img/fire.png'. Not together with image, and not on the quit button."
        },
        "hide_label": {
          "type": "boolean",
          "description": "Hides the label from view; it stays the button's accessible name. Not on the quit button."
        },
        "style": {
          "type": "object",
          "description": "The button's own colours, as theme tokens. Not on the quit button.",
          "maxProperties": 4,
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){1,3}$" },
          "additionalProperties": {
            "oneOf": [
              { "type": "string", "pattern": "^[#A-Za-z0-9.-]{1,32}$" },
              { "type": "number" }
            ]
          }
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 259,
          "description": "A PNG that fills the face of the button: a path relative to the template's folder, like 'img/fire.png'. Only a template in a folder (with a template.yaml) can reference images. Not together with icon, not in the sidebar and not on the quit button."
        }
      }
    }
  }
}
