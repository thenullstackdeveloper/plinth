# Gives the `input` group access to /dev/uinput, so Plinth can create a virtual
# keyboard without root privileges.
#
# Installation:
#   sudo cp packaging/99-uinput.rules /etc/udev/rules.d/99-uinput.rules
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#   # make sure you belong to the `input` group:  sudo usermod -aG input "$USER"
#   # (log out and back in for the group to take effect)
#
# Load the module if it isn't present:  sudo modprobe uinput
KERNEL=="uinput", GROUP="input", MODE="0660", OPTIONS+="static_node=uinput"
