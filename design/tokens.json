{
  "color": {
    "$type": "color",
    "panel": {
      "background": {
        "$value": { "colorSpace": "srgb", "components": [0.067, 0.071, 0.102], "hex": "#11121a" },
        "$description": "Background of the whole panel and of its pages.",
        "$extensions": { "dev.plinth": { "themeable": true } }
      }
    },
    "sidebar": {
      "background": {
        "$value": { "colorSpace": "srgb", "components": [0.098, 0.106, 0.149], "hex": "#191b26" },
        "$description": "Background of the sidebar column.",
        "$extensions": { "dev.plinth": { "themeable": true } }
      }
    },
    "button": {
      "background": {
        "$value": { "colorSpace": "srgb", "components": [0.149, 0.165, 0.231], "hex": "#262a3b" },
        "$description": "Background of a panel button at rest.",
        "$extensions": { "dev.plinth": { "themeable": true } }
      },
      "border": {
        "$value": { "colorSpace": "srgb", "components": [0.384, 0.416, 0.565], "hex": "#626a90" },
        "$description": "Border of a panel button; at least 3:1 against the panel and the sidebar.",
        "$extensions": { "dev.plinth": { "themeable": true } }
      },
      "text": {
        "$value": { "colorSpace": "srgb", "components": [0.902, 0.91, 0.941], "hex": "#e6e8f0" },
        "$description": "Label of a panel button, at rest and pressed.",
        "$extensions": { "dev.plinth": { "themeable": true } }
      },
      "pressed-background": {
        "$value": { "colorSpace": "srgb", "components": [0.204, 0.227, 0.333], "hex": "#343a55" },
        "$description": "Background of a panel button while it is pressed.",
        "$extensions": { "dev.plinth": { "themeable": true } }
      },
      "toggled-background": {
        "$value": { "colorSpace": "srgb", "components": [0.878, 0.69, 0.361], "hex": "#e0b05c" },
        "$description": "Background of a toggle button that is on.",
        "$extensions": { "dev.plinth": { "themeable": true } }
      },
      "toggled-text": {
        "$value": { "colorSpace": "srgb", "components": [0.082, 0.086, 0.118], "hex": "#15161e" },
        "$description": "Label of a toggle button that is on.",
        "$extensions": { "dev.plinth": { "themeable": true } }
      }
    },
    "quit": {
      "background": {
        "$value": { "colorSpace": "srgb", "components": [0.698, 0.227, 0.282], "hex": "#b23a48" },
        "$description": "Background of the Quit button. Fixed, so no theme can disguise it.",
        "$extensions": { "dev.plinth": { "themeable": false } }
      },
      "text": {
        "$value": { "colorSpace": "srgb", "components": [1.0, 1.0, 1.0], "hex": "#ffffff" },
        "$description": "Label of the Quit button. Fixed, so no theme can disguise it.",
        "$extensions": { "dev.plinth": { "themeable": false } }
      }
    }
  },
  "size": {
    "$type": "dimension",
    "sidebar": {
      "width": {
        "$value": { "value": 128, "unit": "px" },
        "$description": "Width of the sidebar column.",
        "$extensions": { "dev.plinth": { "themeable": true, "min": 96, "max": 240 } }
      }
    },
    "button": {
      "min": {
        "$value": { "value": 64, "unit": "px" },
        "$description": "Smallest width and height of a panel button.",
        "$extensions": { "dev.plinth": { "themeable": true, "min": 44, "max": 96 } }
      },
      "border-width": {
        "$value": { "value": 1, "unit": "px" },
        "$description": "Border width of a panel button.",
        "$extensions": { "dev.plinth": { "themeable": true, "min": 0, "max": 4 } }
      }
    },
    "touch": {
      "min": {
        "$value": { "value": 44, "unit": "px" },
        "$description": "Smallest touch target (WCAG 2.5.5). Fixed: the floor every size keeps to.",
        "$extensions": { "dev.plinth": { "themeable": false } }
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "button": {
      "$value": { "value": 10, "unit": "px" },
      "$description": "Corner radius of a panel button.",
      "$extensions": { "dev.plinth": { "themeable": true, "min": 0, "max": 24 } }
    }
  },
  "space": {
    "$type": "dimension",
    "page": {
      "padding": {
        "$value": { "value": 12, "unit": "px" },
        "$description": "Space between the edge of a page and its buttons.",
        "$extensions": { "dev.plinth": { "themeable": true, "min": 0, "max": 24 } }
      },
      "gap": {
        "$value": { "value": 8, "unit": "px" },
        "$description": "Space between two buttons of a page.",
        "$extensions": { "dev.plinth": { "themeable": true, "min": 4, "max": 16 } }
      }
    },
    "sidebar": {
      "padding": {
        "$value": { "value": 8, "unit": "px" },
        "$description": "Space between the edge of the sidebar and its buttons.",
        "$extensions": { "dev.plinth": { "themeable": true, "min": 0, "max": 16 } }
      },
      "gap": {
        "$value": { "value": 8, "unit": "px" },
        "$description": "Space between two buttons of the sidebar.",
        "$extensions": { "dev.plinth": { "themeable": true, "min": 4, "max": 16 } }
      }
    }
  },
  "font": {
    "size": {
      "$type": "dimension",
      "label": {
        "$value": { "value": 16, "unit": "px" },
        "$description": "Font size of a button label.",
        "$extensions": { "dev.plinth": { "themeable": true, "min": 12, "max": 28 } }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "label": {
        "$value": 600,
        "$description": "Font weight of a button label.",
        "$extensions": { "dev.plinth": { "themeable": true, "min": 300, "max": 900 } }
      }
    },
    "line-height": {
      "$type": "number",
      "label": {
        "$value": 1.2,
        "$description": "Line height of a button label, as a multiple of its font size.",
        "$extensions": { "dev.plinth": { "themeable": true, "min": 1.0, "max": 1.6 } }
      }
    },
    "family": {
      "$type": "fontFamily",
      "label": {
        "$value": ["system-ui", "Segoe UI", "Roboto", "sans-serif"],
        "$description": "Font of every label. Fixed: the system font, nothing to download.",
        "$extensions": { "dev.plinth": { "themeable": false } }
      }
    }
  },
  "motion": {
    "$type": "duration",
    "page-transition": {
      "$value": { "value": 200, "unit": "ms" },
      "$description": "How long the change of page takes.",
      "$extensions": { "dev.plinth": { "themeable": true, "min": 0, "max": 400 } }
    },
    "press-feedback": {
      "$value": { "value": 80, "unit": "ms" },
      "$description": "How long a button takes to show it is pressed.",
      "$extensions": { "dev.plinth": { "themeable": true, "min": 0, "max": 200 } }
    }
  }
}
