{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plinth",
  "mainBinaryName": "Plinth",
  "identifier": "com.thenullstackdeveloper.plinth",
  "build": {
    "beforeBuildCommand": "pnpm --dir ../ui build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "thenullstackdeveloper",
    "copyright": "Copyright thenullstackdeveloper",
    "license": "PolyForm-Noncommercial-1.0.0",
    "licenseFile": "../../LICENSE",
    "shortDescription": "Touchscreen control panel for PC games",
    "homepage": "https://github.com/thenullstackdeveloper/plinth",
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
